# === Monorepo root ignores ===
# OS cruft
.DS_Store
**/.DS_Store

# Build / tooling caches (can be hundreds of MB — never commit)
.cache/
**/.cache/
.vite/
**/.vite/

# Screenshots (large PNG artifacts)
.screenshots/
**/.screenshots/

# Local SQLite databases
*.sqlite
*.sqlite3

# Python virtualenvs (KB tooling etc.)
**/.venv/

# Session / scratch artifacts
session-ses_*.md
*.mxd
.claude/scheduled_tasks.lock

# OKF — auto-generated projection layer
okf/

# --- server sync: never commit data, backups, secrets ---
*.sql
*.sql.gz
*.dump
*.db
*.sqlite
*.sqlite3
*.tgz
*.tar
*.tar.gz
*.zip
*.bak
*.bak.*
*.bak-*
*.bak_*
*.bak[0-9]*
*.pg-bak
*.orig
*.clobbered*
*.pem
*.key
*.p12
.env
.env.*
!.env.example
whatsapp-auth*/
whatsapp-media/
backups/
predeploy/
pg-bak-*
app-data-bak-*
.bak-app-*/
